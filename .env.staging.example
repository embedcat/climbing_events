# Тестовый сайт dev.rockevents.ru. Скопируйте в .env.staging (он в .gitignore) и заполните.
# Django
DEBUG=False
# отдельный от боевого: сессии боевого сайта на тестовом не должны работать
SECRET_KEY=change-me-another-long-random-string
ALLOWED_HOSTS=dev.rockevents.ru
CSRF_TRUSTED_ORIGINS=https://dev.rockevents.ru

# Database (must match POSTGRES_* below). Хост db — это контейнер тестовой базы, не боевой
DATABASE_URL=postgres://user:password@db:5432/dbname

# PostgreSQL
POSTGRES_DB=dbname
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Email: письма уходят настоящие, как на боевом сайте. Регистрируйте на тестовом сайте только свои адреса.
DEFAULT_FROM_EMAIL=noreply@rockevents.ru
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Other
USE_DJDT=False
DEFAULT_EVENT_ID=0
# пусто: счётчик Яндекс.Метрики не подключается, статистика боевого сайта не портится
METRIKA_ID=
